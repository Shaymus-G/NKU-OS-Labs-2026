#!/usr/bin/env python3
"""Select the grader's explicit serial backend without QEMU's implicit console."""
import os
from pathlib import Path
import socket
import sys

args = sys.argv[1:]
if any(left == "-serial" and right.startswith("file:")
       for left, right in zip(args, args[1:])):
    args = [arg for arg in args if arg != "-nographic"] + ["-display", "none"]
    if "-gdb" in args:
        # Each case gets a fresh endpoint while the previous QEMU exits.
        with socket.socket() as endpoint:
            endpoint.bind(("127.0.0.1", 0))
            port = endpoint.getsockname()[1]
            Path(".lab5-gdb-port").write_text(str(port))
        args[args.index("-gdb") + 1] = f"tcp:127.0.0.1:{port}"
os.execvp("qemu-system-riscv64", ["qemu-system-riscv64", *args])
