+void
+interrupt_handler(struct trapframe *tf)
+{
+    const uintptr_t interrupt_bit =
+        (uintptr_t)1 << (sizeof(uintptr_t) * 8 - 1);
+
+    uintptr_t cause = tf->cause & ~interrupt_bit;
+
+    switch (cause) {
+    case IRQ_S_TIMER:
+        /*
+         * 时钟中断后重新设置下一次时钟事件。
+         */
+        clock_set_next_event();
+        ticks++;
